OPENAI_API_KEY=sk-change-me
DEVICE_TOKEN=change-device-token
UI_TOKEN=change-ui-token
DATABASE_PATH=/data/companion.db
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_MAX_OUTPUT_TOKENS=4096
PLANNER_MODEL=gpt-5.6-terra
VOICE=marin
REASONING_EFFORT=low
IDLE_TIMEOUT_SECONDS=0
HARD_SESSION_LIMIT_SECONDS=3600
PLAYBACK_BUFFER_SECONDS=120
DIAGNOSTIC_AUDIO=false
OPENAI_TRACE=false
BARGE_IN_ENABLED=false
ANNOUNCE_ACTIVE_PROJECT=true
TRANSCRIPT_RETENTION_DAYS=0
